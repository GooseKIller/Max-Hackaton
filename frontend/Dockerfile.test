# Isolated browsers for machines that cannot launch Playwright locally.
FROM node:22-slim
WORKDIR /tests
RUN apt-get update && apt-get install -y --no-install-recommends chromium fonts-liberation
RUN apt-get install -y --no-install-recommends fonts-dejavu-core
ENV PLAYWRIGHT_EXECUTABLE_PATH=/usr/bin/chromium
RUN npm install --global pnpm@11.19.0
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/playwright.config.ts ./
COPY frontend/tests ./tests
CMD ["pnpm", "test", "--workers=2"]
