# Copy to .env and fill in. NEVER commit .env — it is in .gitignore.

# Bot token issued by the hackathon organizers.
# Without it the service still starts and /health works, but the bot cannot reply.
MAX_BOT_TOKEN=

# MAX Bot API base URL. Change only if the platform docs say so.
MAX_API_BASE=https://platform-api2.max.ru

# Event catalogue, relative to the repository root.
# Currently a SYNTHETIC fixture — see data/README.md.
# Swap for the real PRO.Культура.РФ feed once an integration key arrives.
CATALOG_PATH=data/kazan_events.json

# SQLite file. Holds profiles, taste vectors, the interaction log and the
# catalogue cache. Created on first run.
DB_PATH=data/app.db

# PRO.Культура.РФ integration key. Empty until the partnership request is answered.
# When set, the bot uses the LIVE feed and ignores CATALOG_PATH.
# See docs/outreach/api-key-request.md
PROCULTURE_API_KEY=

# Locale ids for the region to serve (recursive: a region id also covers its cities).
# Do NOT guess these — discover them once with a real key:
#     python3 backend/probe_catalog.py --locales Татарстан
# then pin the id here. Left empty, the API returns ALL of Russia.
PROCULTURE_SUBORDINATIONS=
